{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-gates-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Re-injecting workflow gates (#415)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-loop-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-mutation-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking git-mutation gate (#415)..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/step35-verify-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Enforcing step-3.5 local-verify gate (#657)..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tooling-trigger.sh\"",
            "timeout": 10,
            "statusMessage": "Checking reference-tooling triggers..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/korean-copy-trigger.sh\"",
            "timeout": 10,
            "statusMessage": "Checking Korean-copy triggers (#1094)..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/step35-verify-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Protecting workflow-gate files (#657)..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-activation-gate.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-nag-gate.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for auto-proceed nag (#415)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-activation-gate.mjs"
          }
        ]
      }
    ]
  }
}
