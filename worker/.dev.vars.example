# Marks this as a local worker: it then sends no operator Discord/ntfy alert and writes no
# production Vercel Blob copy (#2058). AIWATCH_LOCAL_ALERTS=1 turns the alerts back on for a
# local check of an alert's Discord output.
AIWATCH_LOCAL=1

# Allowed origins for CORS (use * for local development)
ALLOWED_ORIGIN=*

# Discord webhook URL for alert testing (optional — alerts skip if empty)
DISCORD_WEBHOOK_URL=

# Anthropic API key for AI incident analysis (optional — analysis disabled if empty)
ANTHROPIC_API_KEY=

# Operator secret for POST /api/admin/analyze (#299). Leave empty to disable the
# endpoint (requests will 401). Rotate independently of ANTHROPIC_API_KEY.
# Production: `npx wrangler secret put ADMIN_API_KEY`
ADMIN_API_KEY=
