{
  "name": "aiwatch",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bump-sitemap-lastmod.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "test": "npx playwright test --project=desktop --project=mobile",
    "test:is-down": "npx playwright test --project=is-down",
    "test:edge": "npx playwright test --project=is-down --project=intro --project=reports --project=consent --project=edge-pages",
    "test:worker": "npx vitest run --config worker/vitest.config.ts",
    "typecheck:worker": "node scripts/typecheck-worker.mjs",
    "test:ui": "npx playwright test --ui",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "npx wrangler deploy --config worker/wrangler.toml",
    "dev:worker": "npx wrangler dev --config worker/wrangler.toml --port 8788",
    "dev:all": "npx wrangler dev --config worker/wrangler.toml --port 8788 & vite",
    "test:src": "npx vitest run --config vitest.config.js",
    "test:ext": "npx vitest run --config vitest.config.js extension",
    "test:scripts": "node --test scripts/*.test.mjs",
    "hook-audit": "node scripts/hook-audit-summary.mjs",
    "lint:okf": "node scripts/lint-okf-bundle.mjs",
    "lint:graph": "node scripts/lint-decision-graph.mjs",
    "lint:docs": "node scripts/check-doc-symbols.mjs",
    "lint:korean": "node scripts/lint-korean-copy.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.100.0"
  }
}
